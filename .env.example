# Copy to .env.local for local development. Never commit .env.local.
#
# Local values are written automatically by `npx convex dev`.
# Production values are set in the Vercel and Convex dashboards.

# --- Written by the Convex CLI (local only) ---
# Identifies your personal dev deployment.
CONVEX_DEPLOYMENT=

# --- Required by the Next.js app (local and production) ---
# Public by design: the browser connects directly to this URL.
NEXT_PUBLIC_CONVEX_URL=

# --- Set on the Convex deployment, not in this file ---
# Generated by `npx @convex-dev/auth`. Never commit these.
#   JWT_PRIVATE_KEY   private key used to sign auth tokens
#   JWKS              public key set used to verify them
#   SITE_URL          origin of the deployed frontend, used for auth redirects
#
# --- Set on Vercel only ---
#   CONVEX_DEPLOY_KEY   lets the Vercel build push Convex functions
#                       (build command: npx convex deploy --cmd "next build")
